{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mailpilot/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@mailpilot/server-core": [
        "../../packages/server-core/src/index.ts"
      ]
    }
  },
  "include": [
    "../../packages/server-core/src/**/*",
    "../../packages/shared/src/**/*",
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
