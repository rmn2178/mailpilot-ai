# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Either NEXT_PUBLIC_SUPABASE_ANON_KEY (conventional) or
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (newer name) is accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mailpilot-private

DATABASE_URL=
REDIS_URL=redis://localhost:6379

# ─── Gemini credentials (4 logical slots) ───────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ─── xAI / Grok credentials (4 logical slots) ───────────────────────────────
XAI_API_KEY_1=
XAI_API_KEY_2=
XAI_API_KEY_3=
XAI_API_KEY_4=

# ─── Model IDs per logical slot ─────────────────────────────────────────────
GEMINI_ANALYZE_MODEL=gemini-1.5-pro
GEMINI_GENERATE_MODEL=gemini-1.5-pro
GEMINI_QA_STRUCTURE_MODEL=gemini-1.5-flash
GEMINI_QA_PERSONALIZATION_MODEL=gemini-1.5-flash

GROK_DEFENSIBILITY_MODEL=grok-2-latest
GROK_HUMAN_TONE_MODEL=grok-2-latest
GROK_CONTENT_FIT_MODEL=grok-2-latest
GROK_DELIVERY_HYGIENE_MODEL=grok-2-latest

# ─── Google OAuth (Gmail) ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connections/gmail/callback

# ─── Security ───────────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=

# ─── Worker / queue ─────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
MAX_REVISION_CYCLES=3
MAX_JOB_ATTEMPTS=5
DEFAULT_TIMEZONE=Asia/Kolkata
